{
  "//": "Tests, Node scripts and tool configs. Same strictness as core, plus Node types.",
  "extends": "./tsconfig.core.json",
  "compilerOptions": {
    "types": ["node"],
    "noUnusedLocals": false
  },
  "include": [
    "core/**/*.ts",
    "scripts/**/*.ts",
    "tests/core/**/*.ts",
    "tests/rules/**/*.ts",
    "tests/scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
