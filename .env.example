# Copy to `.env` for local development. `.env` is git-ignored.
#
# Everything prefixed NUXT_PUBLIC_ is inlined into the static build and shipped to
# browsers. These are public identifiers, NOT secrets. In CI they are set as GitHub
# repository *variables* (not secrets).

# Firebase web app config (Firebase console > Project settings > Your apps)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty = analytics disabled.
NUXT_PUBLIC_GA_ID=

# Set to "true" to talk to the local Firebase emulators instead of the real project.
NUXT_PUBLIC_USE_EMULATORS=false

# --- Only for `npm run questions:import` (Node script, never reaches the browser) ---
# The target project must be explicit so the script can never write to the wrong one.
FIREBASE_PROJECT_ID=
# Credentials come from Application Default Credentials: run
#   gcloud auth application-default login
# or point this at a service-account key stored OUTSIDE the repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/key.json
