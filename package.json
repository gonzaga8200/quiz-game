{
  "name": "quiz-game",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "description": "Contrarreloj: a timed Spanish quiz game (Nuxt 4, Firebase).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json",
    "test": "vitest run --project core --project app",
    "test:watch": "vitest --project core --project app",
    "test:coverage": "vitest run --project core --project app --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-contrarreloj \"vitest run --project rules\"",
    "dev:emulators": "nuxt dev --dotenv .env.emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-contrarreloj",
    "questions:validate": "tsx scripts/validate-questions.ts",
    "questions:convert": "tsx scripts/convert-questions.ts",
    "questions:import": "tsx scripts/import-questions.ts",
    "questions:stats": "tsx scripts/question-stats.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.3.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
