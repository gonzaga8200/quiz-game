# Used by `npm run dev:emulators`: points the app at the local Firebase emulators.
# Dummy values on purpose; nothing here is a real credential.
NUXT_PUBLIC_USE_EMULATORS=true
NUXT_PUBLIC_FIREBASE_PROJECT_ID=demo-contrarreloj
NUXT_PUBLIC_FIREBASE_API_KEY=demo-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NUXT_PUBLIC_FIREBASE_APP_ID=1:1:web:demo
